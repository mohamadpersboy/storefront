# ── Database ──────────────────────────────────────────────
MONGODB_URI=

# ── Auth ──────────────────────────────────────────────────
# Random 32+ char secret used to sign session JWTs. Generate with:
# openssl rand -base64 32
AUTH_SECRET=
# Separate secret used only to HMAC-hash OTP codes before storing them.
# Must NOT be the same value as AUTH_SECRET.
OTP_HASH_SECRET=

# ── Cloudinary (image management) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMS.ir (OTP delivery) ────────────────────────────────
SMS_IR_API_KEY=
# Only used for the general-purpose Bulk send method (e.g. future order
# notifications) — the OTP flow itself uses the Pattern/Verify method
# below and does not need this.
SMS_IR_LINE_NUMBER=
# Numeric ID of the approved Pattern/Verify template in the sms.ir panel
# (Programmers → Patterns) with a single "Code" parameter. Used for OTP.
SMS_IR_OTP_TEMPLATE_ID=

# ── Zarinpal (online payment gateway) ────────────────────
# Merchant ID from your Zarinpal panel (only exists after business
# verification — leave ZARINPAL_MODE=sandbox until you have one).
ZARINPAL_MERCHANT_ID=
# "sandbox" | "production" — sandbox makes no real transaction.
ZARINPAL_MODE=sandbox

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
