# کپی این فایل رو با نام .env.vercel.local بساز و مقادیر واقعی رو پر کن.
# .env.vercel.local هیچ‌وقت Commit نمی‌شود (در .gitignore هست، همون
# الگوی .env* که .env.local رو هم Ignore می‌کند).
#
# سپس اجرا کن: bash scripts/vercel-env-sync.sh
#
# این مقادیر روی هر سه محیط Vercel (Production, Preview, Development)
# ثبت می‌شوند. اگر مقداری برای یک محیط خاص باید فرق کند (مثلاً
# NEXT_PUBLIC_APP_URL برای دامنه اصلی Production)، بعداً از Vercel
# Dashboard دستی اصلاحش کن — این اسکریپت فقط برای Setup اولیه یا
# Sync سریع همه محیط‌ها با یک مقدار است.

MONGODB_URI=
AUTH_SECRET=
OTP_HASH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=
SMS_IR_OTP_TEMPLATE_ID=
